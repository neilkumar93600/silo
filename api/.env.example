# Postgres (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-byte-random-hex
BETTER_AUTH_URL=http://localhost:4000

# CORS - the origin(s) allowed to call this API with credentials
WEB_ORIGIN=http://localhost:3000

# Server
PORT=4000
NODE_ENV=development

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Upload limits
MAX_UPLOAD_BYTES=2147483648

# OpenRouter (AI assistant) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# SendGrid (verification + password reset email) - https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
